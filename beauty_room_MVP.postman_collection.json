    {
      "name": "Appointments",
      "item": [
        {
          "name": "Available slots (X-Tenant-ID)",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Tenant-ID", "value": "{{X_TENANT_ID}}"}],
            "url": {
              "raw": "{{BASE_URL}}/api/appointment/slots?stylistId=1&serviceId=1&date=2026-08-10",
              "query": [
                {"key": "stylistId", "value": "1"},
                {"key": "serviceId", "value": "1"},
                {"key": "date", "value": "2026-08-10"}
              ]
            }
          }
        },
        {
          "name": "Get appointment by id",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{JWT}}"}],
            "url": {"raw": "{{BASE_URL}}/api/appointment/findById/1", "path": ["api", "appointment", "findById", "1"]}
          }
        },
        {
          "name": "Appointments by stylist",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{JWT}}"}],
