# Spring profile selection
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mariadb://localhost:3306/beauty_room
DB_USERNAME=dev
DB_PASSWORD=dev123
DB_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect
DDL_AUTO=create-drop
SHOW_SQL=true
FORMAT_SQL=true
HIBERNATE_SQL_LOG_LEVEL=DEBUG
HIBERNATE_JDBC_LOG_LEVEL=DEBUG
IMPORT_SQL_FILE=import.sql
SQL_INIT_MODE=always
# Flyway desactivado por defecto: el esquema lo gestiona Hibernate (create-drop) + import.sql.
FLYWAY_ENABLED=false

# JWT (>= 32 caracteres para HMAC-SHA256)
JWT_SECRET_KEY=change-me-with-a-secret-of-at-least-32-chars!!

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_PATH=/api/telegram/webhook
# URL HTTPS pública que reenvíe a http://localhost:8080/api/telegram/webhook.
# Deja vacío si no tenés túnel; el bot no recibirá updates hasta configurarla.
# Ej: ngrok http 8080 -> TELEGRAM_BOT_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/telegram/webhook
TELEGRAM_BOT_WEBHOOK_URL=

# Reminders
REMINDERS_INTERVAL=0 */15 * * * *
REMINDERS_DAILY_SUMMARY=0 0 7 * * *
