# Spring profile selection
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mariadb://localhost:3306/beauty_room
DB_USERNAME=dev
DB_PASSWORD=dev123
DB_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver
# MariaDBDialect es el dialecto correcto para MariaDB (MySQLDialect falla el validate
# de Hibernate contra MariaDB 12.x: no encuentra las tablas).
DB_DIALECT=org.hibernate.dialect.MariaDBDialect
# Fase 2 del plan de mejora: el esquema lo gestiona Flyway; Hibernate solo valida.
DDL_AUTO=validate
SHOW_SQL=true
FORMAT_SQL=true
HIBERNATE_SQL_LOG_LEVEL=DEBUG
HIBERNATE_JDBC_LOG_LEVEL=DEBUG
# El seed vive en V2__seed_data.sql; import.sql ya no se usa en dev.
IMPORT_SQL_FILE=
SQL_INIT_MODE=never
# Flyway activo por defecto; baseline-on-migrate=true permite adoptar la DB existente.
FLYWAY_ENABLED=true

# JWT (>= 32 caracteres para HMAC-SHA256)
JWT_SECRET_KEY=change-me-with-a-secret-of-at-least-32-chars!!

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_PATH=/api/telegram/webhook
# URL HTTPS pública que reenvíe a http://localhost:8080/api/telegram/webhook.
# Deja vacío si no tenés túnel; el bot no recibirá updates hasta configurarla.
# Ej: ngrok http 8080 -> TELEGRAM_BOT_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/telegram/webhook
TELEGRAM_BOT_WEBHOOK_URL=

# Reminders
REMINDERS_INTERVAL=0 */15 * * * *
REMINDERS_DAILY_SUMMARY=0 0 7 * * *

# WhatsApp (Meta Cloud API)
# Deja access-token y phone-number-id vacíos y el canal queda desactivado.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número del WABA (con código de país, sin +, ej: 5491101234567) para los links wa.me.
WHATSAPP_PHONE_NUMBER=
# Token de verificación propio (el que configurás en el dashboard de Meta al registrar el webhook).
WHATSAPP_VERIFY_TOKEN=
# App secret de la app de Meta: verifica la firma X-Hub-Signature-256 de los POST del webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PATH=/api/whatsapp/webhook
# URL HTTPS pública que reenvíe a http://localhost:8080/api/whatsapp/webhook (mismo túnel que Telegram).
WHATSAPP_WEBHOOK_URL=
